{
  "name": "chatbot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express server that proxies chat requests to the Gemini API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:test": "node src/config/test-db.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:embed": "node src/db/embed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.0"
  }
}